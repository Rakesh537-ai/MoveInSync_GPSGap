# Local demonstration only. These demo users are not production accounts.
DEMO_MODE=true
DATABASE_PATH=data/gps.db
ROUTING_PROVIDER=mock
MAX_SPEED_KMH=120
MAX_ACCURACY_M=50
INCLUDE_NO_SHOWS=false
CIRCUIT_RESET_SECONDS=5
